# Copy this file to .env and fill in your values.

# Portkey API key (required for LLM synthesis)
PORTKEY_API_KEY=

# GCP project (defaults to rea-gcp-dp-dev if unset)
GCP_PROJECT=rea-gcp-dp-dev

# GCP credentials — path to your ADC JSON file
# Defaults to ~/.config/gcloud/application_default_credentials.json if unset
GOOGLE_APPLICATION_CREDENTIALS=
